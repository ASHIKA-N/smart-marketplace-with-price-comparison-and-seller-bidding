{
  "name": "aroundly",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.17.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages",
    "format": "prettier --write .",
    "test": "tsx --test packages/shared/src/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "tsx apps/api/prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "pnpm": "^10.17.1"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "^2.3.0"
    },
    "next": {
      "postcss": "^8.5.23"
    },
    "deepmerge-ts": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "postcss": "^8.5.23",
      "deepmerge-ts": "^8.0.0"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
